// Cargar un mapa
function loadMap(mapKey) {
    const map = MAPS[mapKey];
    if (!map) {
        room.sendAnnouncement("❌ Mapa no encontrado", null, 0xFF0000, "bold", 2);
        return false;
    }
    
    try {
        room.setCustomStadium(map.stadium);
        room.setScoreLimit(map.scoreLimit);
        room.setTimeLimit(map.timeLimit);
        
        currentMapKey = mapKey;
        
        // Actualizar historial
        mapHistory.push(mapKey);
        if (mapHistory.length > MAX_MAP_HISTORY) {
            mapHistory.shift();
        }
        
        room.sendAnnouncement(`🗺️ Mapa cargado: ${map.name}`, null, 0x00FF00, "bold", 2);
        return true;
    } catch (e) {
        room.sendAnnouncement("❌ Error al cargar el mapa", null, 0xFF0000, "bold", 2);
        console.log("Error loading map:", e);
        return false;
    }
}

// Obtener mapas disponibles (excluir los recientes)
function getAvailableMaps() {
    return Object.keys(MAPS).filter(key => !mapHistory.includes(key));
}

// Obtener mapa aleatorio
function getRandomMap() {
    const available = getAvailableMaps();
    if (available.length === 0) {
        mapHistory = []; // Reset history si no hay mapas disponibles
        return Object.keys(MAPS)[Math.floor(Math.random() * Object.keys(MAPS).length)];
    }
    return available[Math.floor(Math.random() * available.length)];
}

// Iniciar votación de mapas
function startMapVoting() {
    if (mapVoting.active) return;
    
    mapVoting.active = true;
    mapVoting.votes = {};
    mapVoting.votedPlayers = new Set();
    
    // Seleccionar 3 mapas aleatorios
    const available = getAvailableMaps();
    let options = [];
    
    for (let i = 0; i < 3 && available.length > 0; i++) {
        const randomIndex = Math.floor(Math.random() * available.length);
        options.push(available[randomIndex]);
        available.splice(randomIndex, 1);
    }
    
    // Si no hay suficientes mapas disponibles, agregar aleatorios
    while (options.length < 3) {
        const allKeys = Object.keys(MAPS);
        const randomKey = allKeys[Math.floor(Math.random() * allKeys.length)];
        if (!options.includes(randomKey)) {
            options.push(randomKey);
        }
    }
    
    mapVoting.mapOptions = options;
    mapVoting.endTime = Date.now() + 30000; // 30 segundos para votar
    
    room.sendAnnouncement("╔═══════════════════════════════════╗", null, 0xFFFF00, "bold", 0);
    room.sendAnnouncement("           🗳️ VOTACIÓN DE MAPAS 🗳️", null, 0xFFFF00, "bold", 0);
    room.sendAnnouncement("╠═══════════════════════════════════╣", null, 0xFFFF00, "bold", 0);
    
    options.forEach((key, index) => {
        const map = MAPS[key];
        room.sendAnnouncement(`  ${index + 1}. ${map.name}`, null, 0xFFFFFF, "normal", 0);
        room.sendAnnouncement(`     Categoría: ${map.category}`, null, 0xAAAAAA, "normal", 0);
        mapVoting.votes[index + 1] = 0;
    });
    
    room.sendAnnouncement("╠═══════════════════════════════════╣", null, 0xFFFF00, "bold", 0);
    room.sendAnnouncement("  Escribe !vote 1, !vote 2 o !vote 3", null, 0xFFFF00, "normal", 0);
    room.sendAnnouncement("  Tienes 30 segundos para votar ⏱️", null, 0xFFFF00, "normal", 0);
    room.sendAnnouncement("╚═══════════════════════════════════╝", null, 0xFFFF00, "bold", 0);
    
    // Timer para finalizar votación
    setTimeout(() => {
        endMapVoting();
    }, 30000);
}

// Votar por un mapa
function voteMap(player, mapNumber) {
    if (!mapVoting.active) {
        room.sendAnnouncement("❌ No hay votación activa", player.id, 0xFF0000, "normal", 2);
        return;
    }
    
    if (mapVoting.votedPlayers.has(player.id)) {
        room.sendAnnouncement("❌ Ya votaste", player.id, 0xFF0000, "normal", 2);
        return;
    }
    
    if (!mapVoting.votes.hasOwnProperty(mapNumber)) {
        room.sendAnnouncement("❌ Opción inválida. Usa !vote 1, !vote 2 o !vote 3", player.id, 0xFF0000, "normal", 2);
        return;
    }
    
    // Calcular peso del voto según rango
    const elo = playerELO[player.auth] || 1000;
    const rank = getRankByELO(elo);
    let voteWeight = 1;
    
    if (rank === RANKS.TIGRE_LEGENDARIO) voteWeight = 3;
    else if (rank === RANKS.TIGRE_ALPHA) voteWeight = 2;
    else if (rank === RANKS.TIGRE_JOVEN) voteWeight = 1.5;
    
    mapVoting.votes[mapNumber] += voteWeight;
    mapVoting.votedPlayers.add(player.id);
    
    const mapName = MAPS[mapVoting.mapOptions[mapNumber - 1]].name;
    room.sendAnnouncement(`✅ Voto registrado: ${mapName} (peso: x${voteWeight})`, player.id, 0x00FF00, "normal", 2);
}

// Finalizar votación de mapas
function endMapVoting() {
    if (!mapVoting.active) return;
    
    mapVoting.active = false;
    
    // Encontrar el mapa con más votos
    let maxVotes = 0;
    let winningOption = 1;
    
    for (let option in mapVoting.votes) {
        if (mapVoting.votes[option] > maxVotes) {
            maxVotes = mapVoting.votes[option];
            winningOption = parseInt(option);
        }
    }
    
    const winningMapKey = mapVoting.mapOptions[winningOption - 1];
    const winningMap = MAPS[winningMapKey];
    
    room.sendAnnouncement("╔═══════════════════════════════════╗", null, 0x00FF00, "bold", 0);
    room.sendAnnouncement("        🏆 RESULTADO DE VOTACIÓN 🏆", null, 0x00FF00, "bold", 0);
    room.sendAnnouncement("╠═══════════════════════════════════╣", null, 0x00FF00, "bold", 0);
    room.sendAnnouncement(`  Mapa ganador: ${winningMap.name}`, null, 0xFFFFFF, "normal", 0);
    room.sendAnnouncement(`  Total de votos: ${maxVotes.toFixed(1)}`, null, 0xFFFFFF, "normal", 0);
    room.sendAnnouncement("╚═══════════════════════════════════╝", null, 0x00FF00, "bold", 0);
    
    // Cargar el mapa ganador
    setTimeout(() => {
        loadMap(winningMapKey);
    }, 2000);
}

