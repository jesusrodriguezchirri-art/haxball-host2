// Obtener rango según ELO
function getRankByELO(elo) {
    for (let rank of Object.values(RANKS)) {
        if (elo >= rank.minELO && elo <= rank.maxELO) {
            return rank;
        }
    }
    return RANKS.CACHORRO;
}

// Obtener prefijo completo del jugador
function getPlayerPrefix(player) {
    // Verificación estricta de owner
    if (ownerAuth !== null && player.auth === ownerAuth) {
        return "[OWNER]";
    }
    
    // Verificación estricta de admin
    if (adminList.has(player.auth)) {
        return "[ADM]";
    }
    
    // Si no es owner ni admin, mostrar rango según ELO
    const elo = playerELO[player.auth] || 1000;
    const rank = getRankByELO(elo);
    return rank.prefix;
}

// Obtener color del jugador
function getPlayerColor(player) {
    // Verificación estricta de owner/admin
    if ((ownerAuth !== null && player.auth === ownerAuth) || adminList.has(player.auth)) {
        return 0x9966FF; // Violeta
    }
    
    const elo = playerELO[player.auth] || 1000;
    const rank = getRankByELO(elo);
    return rank.color;
}

