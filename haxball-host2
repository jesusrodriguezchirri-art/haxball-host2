// Verificar si el jugador puede usar un comando (cooldown)
function canUseCommand(playerId, commandName, cooldownSeconds) {
    const now = Date.now();
    const key = `${playerId}_${commandName}`;
    
    if (!playerCooldowns[key]) {
        playerCooldowns[key] = now;
        return true;
    }
    
    const timePassed = (now - playerCooldowns[key]) / 1000;
    if (timePassed >= cooldownSeconds) {
        playerCooldowns[key] = now;
        return true;
    }
    
    return false;
}

// Obtener tiempo restante de cooldown
function getCooldownRemaining(playerId, commandName, cooldownSeconds) {
    const now = Date.now();
    const key = `${playerId}_${commandName}`;
    
    if (!playerCooldowns[key]) return 0;
    
    const timePassed = (now - playerCooldowns[key]) / 1000;
    const remaining = Math.ceil(cooldownSeconds - timePassed);
    return remaining > 0 ? remaining : 0;
}

