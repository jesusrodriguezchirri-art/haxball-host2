room.onTeamVictory = function(scores) {
    const redPlayers = room.getPlayerList().filter(p => p.team === 1);
    const bluePlayers = room.getPlayerList().filter(p => p.team === 2);
    
    let winners, losers;
    
    if (scores.red > scores.blue) {
        winners = redPlayers;
        losers = bluePlayers;
        room.sendAnnouncement("🔴 ¡VICTORIA DEL EQUIPO ROJO! 🔴", null, 0xFF0000, "bold", 2);
    } else if (scores.blue > scores.red) {
        winners = bluePlayers;
        losers = redPlayers;
        room.sendAnnouncement("🔵 ¡VICTORIA DEL EQUIPO AZUL! 🔵", null, 0x0000FF, "bold", 2);
    } else {
        // Empate
        [...redPlayers, ...bluePlayers].forEach(p => {
            playerStats[p.auth].draws++;
        });
        saveData();
        room.sendAnnouncement("🤝 ¡EMPATE! Ambos equipos jugaron bien", null, 0xFFFF00, "bold", 2);
        
        // Iniciar votación de mapas después del empate
        setTimeout(() => {
            startMapVoting();
        }, 3000);
        return;
    }
    
    // Actualizar ELO
    updateELO(winners, losers);
    
    // Iniciar votación de mapas
    setTimeout(() => {
        startMapVoting();
    }, 3000);
};

room.onTeamGoal = function(team) {
    const goalScorers = room.getPlayerList().filter(p => p.team === team);
    
    // Actualizar stats de goles (simplificado)
    if (goalScorers.length > 0) {
        const lastPlayer = goalScorers[goalScorers.length - 1];
        if (playerStats[lastPlayer.auth]) {
            playerStats[lastPlayer.auth].goals++;
            saveData();
        }
    }
};

