function calculateELOChange(winnerELO, loserELO, kFactor = 32) {
    const expectedScore = 1 / (1 + Math.pow(10, (loserELO - winnerELO) / 400));
    return Math.round(kFactor * (1 - expectedScore));
}

function updateELO(winners, losers) {
    const avgWinnerELO = winners.reduce((sum, p) => sum + (playerELO[p.auth] || 1000), 0) / winners.length;
    const avgLoserELO = losers.reduce((sum, p) => sum + (playerELO[p.auth] || 1000), 0) / losers.length;
    
    const eloChange = calculateELOChange(avgWinnerELO, avgLoserELO);
    
    winners.forEach(player => {
        playerELO[player.auth] = (playerELO[player.auth] || 1000) + eloChange;
        playerStats[player.auth].wins++;
    });
    
    losers.forEach(player => {
        playerELO[player.auth] = Math.max(0, (playerELO[player.auth] || 1000) - eloChange);
        playerStats[player.auth].losses++;
    });
    
    saveData();
    
    room.sendAnnouncement(`📊 ELO actualizado: +${eloChange} ganadores / -${eloChange} perdedores`, null, 0xFFFF00, "normal", 2);
}

