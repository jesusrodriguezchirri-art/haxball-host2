        console.log(`🧹 Admins cleared by ${player.name}. Removed: ${oldSize}`);
        return false;
    }
    
    if (command === "!resetowner") {
        // COMANDO DE EMERGENCIA - Solo funciona si NO hay owner establecido
        if (ownerAuth !== null && ownerAuth !== "") {
            room.sendAnnouncement("❌ Ya existe un OWNER establecido", player.id, 0xFF0000, "normal", 2);
            room.sendAnnouncement("💡 El OWNER actual debe usar !clearadmins primero", player.id, 0xFFFF00, "normal", 2);
            return false;
        }
        
        // Si NO hay owner, permitir que alguien lo tome
        ownerAuth = player.auth;
        adminList.clear();
        adminList.add(player.auth);
        saveData();
        
        setTimeout(() => {
            room.setPlayerAdmin(player.id, true);
        }, 100);
        
        room.sendAnnouncement("🚨 OWNERSHIP RECLAMADO 🚨", null, 0xFF0000, "bold", 2);
        room.sendAnnouncement(`👑 ${player.name} es ahora el OWNER`, null, 0xFFD700, "bold", 2);
        
        console.log(`🚨 OWNERSHIP RESET by ${player.name}`);
        return false;
    }
    
    if (command === "!nukesystem") {
        // SOLO funciona si escribes exactamente el comando + confirmación
        const confirmation = args.slice(1).join(' ');
        
        if (confirmation !== "CONFIRMAR RESET TOTAL") {
            room.sendAnnouncement("⚠️ COMANDO DE EMERGENCIA NUCLEAR ⚠️", player.id, 0xFF0000, "bold", 2);
            room.sendAnnouncement("Este comando BORRA TODO:", player.id, 0xFF0000, "normal", 2);
            room.sendAnnouncement("- Owner actual", player.id, 0xFF0000, "normal", 2);
            room.sendAnnouncement("- Todos los admins", player.id, 0xFF0000, "normal", 2);
            room.sendAnnouncement("- TODO el ELO", player.id, 0xFF0000, "normal", 2);
            room.sendAnnouncement("- TODAS las stats", player.id, 0xFF0000, "normal", 2);
            room.sendAnnouncement("", player.id, 0x000000, "normal", 0);
            room.sendAnnouncement("Para confirmar, escribe:", player.id, 0xFFFF00, "bold", 2);
            room.sendAnnouncement("!nukesystem CONFIRMAR RESET TOTAL", player.id, 0xFFFF00, "bold", 2);
            return false;
        }
        
        // RESET NUCLEAR - Borra TODO
        ownerAuth = null;
        adminList.clear();
        playerELO = {};
        playerStats = {};
        playerCooldowns = {};
        
        // Quitar admin a todos
        room.getPlayerList().forEach(p => {
            room.setPlayerAdmin(p.id, false);
        });
        
        saveData();
        
        room.sendAnnouncement("💥💥💥 RESET NUCLEAR COMPLETADO 💥💥💥", null, 0xFF0000, "bold", 2);
        room.sendAnnouncement("🔄 Sistema reiniciado completamente", null, 0xFF0000, "bold", 2);
        room.sendAnnouncement("📝 El primer jugador puede usar !owner123", null, 0xFFD700, "bold", 2);
        
        console.log(`💥 NUCLEAR RESET executed by ${player.name}`);
        return false;
    }
    
    // Comandos para OWNER y ADMIN
    if (command === "!forcemap") {
        if (!isOwner && !isAdmin) {
            room.sendAnnouncement("❌ Solo OWNER/ADMIN pueden forzar mapas", player.id, 0xFF0000, "normal", 2);
            return false;
        }
        
        const mapKey = args[1];
        if (!mapKey || !MAPS[mapKey]) {
            room.sendAnnouncement("❌ Uso: !forcemap <código> | Usa !maps para ver códigos", player.id, 0xFF0000, "normal", 2);
            return false;
        }
        
        loadMap(mapKey);
        const roleText = isOwner ? "OWNER" : "ADMIN";
        room.sendAnnouncement(`🗺️ ${roleText} ha forzado el mapa: ${MAPS[mapKey].name}`, null, 0x9966FF, "bold", 2);
        return false;
    }
    
    if (command === "!rr") {
        if (!isOwner && !isAdmin) {
            room.sendAnnouncement("❌ Solo OWNER/ADMIN pueden reiniciar partidas", player.id, 0xFF0000, "normal", 2);
            return false;
        }
        
        room.stopGame();
        room.startGame();
        const roleText = isOwner ? "OWNER" : "ADMIN";
        room.sendAnnouncement(`🔄 Partida reiniciada por ${roleText}`, null, 0x9966FF, "bold", 2);
        return false;
    }
    
    if (command === "!kick") {
        if (!isOwner && !isAdmin) {
            room.sendAnnouncement("❌ Solo OWNER/ADMIN pueden expulsar jugadores", player.id, 0xFF0000, "normal", 2);
            return false;
        }
        
        const targetName = args[1];
        const reason = args.slice(2).join(' ') || "Sin razón especificada";
        
        if (!targetName) {
            room.sendAnnouncement("❌ Uso: !kick <nombre> [razón]", player.id, 0xFF0000, "normal", 2);
            return false;
        }
        
        const targetPlayer = room.getPlayerList().find(p => p.name === targetName);
        if (!targetPlayer) {
            room.sendAnnouncement("❌ Jugador no encontrado", player.id, 0xFF0000, "normal", 2);
            return false;
        }
        
        room.kickPlayer(targetPlayer.id, reason, false);
        room.sendAnnouncement(`🚫 ${targetPlayer.name} expulsado. Razón: ${reason}`, null, 0xFF0000, "bold", 2);
        return false;
    }
    
    if (command === "!mute") {
        if (!isOwner && !isAdmin) {
            room.sendAnnouncement("❌ Solo OWNER/ADMIN pueden mutear jugadores", player.id, 0xFF0000, "normal", 2);
            return false;
        }
        
        const targetName = args.slice(1).join(' ');
        const targetPlayer = room.getPlayerList().find(p => p.name === targetName);
        
        if (!targetPlayer) {
            room.sendAnnouncement("❌ Jugador no encontrado", player.id, 0xFF0000, "normal", 2);
            return false;
        }
        
        // Agregar a lista de muteados (necesitarías implementar esto)
        room.sendAnnouncement(`🔇 ${targetPlayer.name} ha sido muteado`, null, 0xFF0000, "bold", 2);
        return false;
    }
}

